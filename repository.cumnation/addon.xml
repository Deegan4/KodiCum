<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.cumnation"
       name="Cumnation Repository"
       version="1.0.0"
       provider-name="KodiCum">
    <extension point="xbmc.addon.repository" name="Cumnation Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/Deegan4/KodiCum/main/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Deegan4/KodiCum/main/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Deegan4/KodiCum/main/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_gb">Install and update the Cumnation add-on</summary>
        <description lang="en_gb">Repository for the Cumnation video add-on. Add this to receive Cumnation and its updates directly inside Kodi.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
