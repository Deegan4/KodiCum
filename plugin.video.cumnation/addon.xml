<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.cumnation"
       name="Cumnation"
       version="1.0.0"
       provider-name="KodiCum">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.22.0"/>
        <import addon="script.module.beautifulsoup4" version="4.6.2"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_gb">Cumnation video add-on for Kodi</summary>
        <description lang="en_gb">A configurable video add-on for Kodi. Browse categories, search, keep favorites and a resume-aware watch history, and play from a content source you configure. Content-source agnostic: point it at your own JSON API or HTML source.</description>
        <platform>all</platform>
        <license>MIT</license>
        <language>en</language>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
        <news>v1.0.0 - Initial release: categories, search, favorites, history, pagination, settings.</news>
    </extension>
</addon>
