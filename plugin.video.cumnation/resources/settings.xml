<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.cumnation">
        <category id="source" label="32100">
            <group id="1">
                <setting id="base_url" type="string" label="32101" help="32102">
                    <level>0</level>
                    <default></default>
                    <control type="edit" format="string">
                        <heading>32101</heading>
                    </control>
                </setting>
                <setting id="user_agent" type="string" label="32103" help="32104">
                    <level>1</level>
                    <default>Mozilla/5.0 (Kodi) Cumnation/1.0</default>
                    <control type="edit" format="string">
                        <heading>32103</heading>
                    </control>
                </setting>
                <setting id="page_size" type="integer" label="32105" help="32106">
                    <level>1</level>
                    <default>30</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>10</step>
                        <maximum>100</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="test_connection" type="action" label="32140">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.cumnation/?action=test_connection)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>
        <category id="network" label="32130">
            <group id="1">
                <setting id="cache_ttl" type="integer" label="32131" help="32132">
                    <level>0</level>
                    <default>10</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="network_retries" type="integer" label="32133" help="32134">
                    <level>1</level>
                    <default>2</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>1</step>
                        <maximum>5</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
            </group>
        </category>
        <category id="devices" label="32150">
            <group id="1">
                <setting id="dlna_enabled" type="boolean" label="32151" help="32152">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="dlna_timeout" type="integer" label="32153" help="32154">
                    <level>1</level>
                    <default>3</default>
                    <dependencies>
                        <dependency type="enable" setting="dlna_enabled" operator="is">true</dependency>
                    </dependencies>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>10</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="dlna_cache_ttl" type="integer" label="32155" help="32156">
                    <level>1</level>
                    <default>5</default>
                    <dependencies>
                        <dependency type="enable" setting="dlna_enabled" operator="is">true</dependency>
                    </dependencies>
                    <constraints>
                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="scan_devices" type="action" label="32157">
                    <level>0</level>
                    <dependencies>
                        <dependency type="enable" setting="dlna_enabled" operator="is">true</dependency>
                    </dependencies>
                    <data>RunPlugin(plugin://plugin.video.cumnation/?action=scan_devices)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>
        <category id="playback" label="32110">
            <group id="1">
                <setting id="quality" type="integer" label="32135" help="32136">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="32137">0</option>
                            <option label="32138">1</option>
                            <option label="1080p">1080</option>
                            <option label="720p">720</option>
                            <option label="480p">480</option>
                            <option label="360p">360</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="integer"/>
                </setting>
                <setting id="resume_playback" type="boolean" label="32111" help="32112">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="track_history" type="boolean" label="32113" help="32114">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="history_size" type="integer" label="32115" help="32116">
                    <level>1</level>
                    <default>50</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>10</step>
                        <maximum>200</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
            </group>
        </category>
        <category id="maintenance" label="32120">
            <group id="1">
                <setting id="clear_search_history" type="action" label="32121">
