                </setting>
                <setting id="clear_cache" type="action" label="32124">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.cumnation/?action=clear_cache)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
